#!/bin/sh
set -eu
[ "$1" = configure ] || exit 0
for account in gospot-stage gospot-wizard gospot-panel; do
    if ! getent passwd "$account" >/dev/null; then
        useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$account"
    fi
    test "$(id -u "$account")" -ne 0
done
# A board that ran pistar-dashboard: settings, credentials, state and service
# accounts move to the gospot names (a no-op after the first run).
@DASHBOARD_LIB_DIR@/gospot-migrate
# A locally edited conffile keeps its values but gains settings added by
# newer packages; otherwise the services would refuse to start.
@DASHBOARD_LIB_DIR@/gospot-conf-merge /etc/gospot/gospot.conf @DASHBOARD_LIB_DIR@/gospot.conf.default
# The HTTPS management credentials: kept when present (the OS image removes
# the build-time ones and creates them again on each board's first boot).
@WIZARD_SECRETS_HELPER@
/usr/sbin/visudo -cf /etc/sudoers.d/gospot
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    for unit in gospot-panel gospot-wizard gospot-stage; do
        systemctl enable "$unit.service"
        systemctl restart "$unit.service"
        systemctl is-active --quiet "$unit.service"
    done
fi
