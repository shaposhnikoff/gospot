#!/bin/bash
# pistar-remote service handler (start|stop|restart|status), as in Pi-Star.
# Pi-Star's own handler runs "/usr/bin/python /usr/local/sbin/pistar-remote",
# which Python 3 systems lack; this one runs the Python 3 port that is
# installed next to it and finds it by its command line. Like Pi-Star's, it
# does not start the remote while CONF_PISTAR_REMOTE disables it.
set -u
daemon=$(dirname "$(readlink -f "$0")")/pistar-remote
name=pistar-remote
pattern="^[^ ]*python3 -I $daemon( |\$)"

pids() { pgrep -f -- "$pattern" | tr '\n' ' '; }

start() {
	"$daemon" </dev/null &
	echo "$name started as PID $!"
}

stop() {
	local p
	p=$(pids)
	kill $p 2>/dev/null
	for _ in $(seq 50); do
		[[ -z $(pids) ]] && return 0
		sleep 0.1
	done
	kill -KILL $(pids) 2>/dev/null
	return 0
}

enabled() {
	"$daemon" --enabled && return 0
	echo "$name is disabled"
	return 1
}

[[ -x $daemon ]] || exit 0

case "${1:-}" in
	start)
		if [[ -n $(pids) ]]; then echo "$name is already running as PID $(pids)"; exit 0; fi
		enabled || exit 0
		start
		;;
	stop)
		if [[ -z $(pids) ]]; then echo "$name is not running"; exit 0; fi
		echo "Killing $name PID $(pids)"
		stop
		;;
	restart)
		if [[ -n $(pids) ]]; then echo "Killing $name PID $(pids)"; stop; else echo "$name is not running"; fi
		enabled || exit 0
		start
		;;
	status)
		if [[ -n $(pids) ]]; then echo "$name is running as PID $(pids)"; else echo "$name is not running"; fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		;;
esac
exit 0
