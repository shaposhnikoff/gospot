#!/usr/bin/python3 -I
"""Test-only transport: redirect exactly two restart targets to disposable systemd units
and record the stop/start of units around a calibration."""
import pathlib
import socket
import sys

# pistar-configure asks which units are installed before restarting them.
if sys.argv[1:4] == ["show", "-p", "LoadState"] and len(sys.argv) == 6 and sys.argv[4] == "--value":
    print("loaded" if sys.argv[5] in ("dmrgateway.service", "mmdvmhost.service") else "not-found")
    sys.exit(0)
qa = pathlib.Path("/run/pistar-qa")
# pistar-calibrate holds MMDVMHost around MMDVMCal: only the two QA units are
# active; a stop or start is recorded (no unit changes), a restart goes below.
if len(sys.argv) == 4 and sys.argv[1:3] == ["is-active", "--quiet"]:
    sys.exit(0 if sys.argv[3] in ("dmrgateway.service", "mmdvmhost.service") else 3)
if len(sys.argv) == 3 and sys.argv[1] in ("stop", "start"):
    with (qa / "events").open("a") as events:
        print(sys.argv[2], sys.argv[1], file=events)
    sys.exit(0)
assert len(sys.argv) == 3 and sys.argv[1] == "restart"
unit = sys.argv[2]
assert unit in ("dmrgateway.service", "mmdvmhost.service")
fault = qa / ("fail-next-" + unit.removesuffix(".service"))
fail = fault.exists()
fault.unlink(missing_ok=True)
with socket.socket(socket.AF_UNIX) as sock:
    sock.settimeout(10)
    sock.connect("/qa-bridge/control")
    sock.sendall((unit + (" fail" if fail else " ok") + "\n").encode())
    sock.shutdown(socket.SHUT_WR)
    result = sock.makefile("rb").read(16).decode().strip()
if result not in ("ok", "fail"):
    sys.exit("no reply from isolated service manager")
with (qa / "events").open("a") as events:
    print(unit, result, file=events)
sys.exit(0 if result == "ok" else 1)
