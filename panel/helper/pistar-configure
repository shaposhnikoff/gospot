# fulledit_cron.php pistar_cron_validate(): one diagnostic per offending line.
CRON_RULES = [(re.compile(p, f), why) for p, f, why in (
    (r"(?:^|[\s/;|&`$()=])(passwd|chpasswd|htpasswd)\b", re.I, "invokes a password-modification command (passwd / chpasswd / htpasswd)"),
    (r"\busermod\b[^\n]*\s-p\b", re.I, "usermod -p sets a password hash directly"),
    (r"(/etc/shadow|/etc/passwd|\.htpasswd)\b", re.I, "references an authentication file path"),
    (r"(?:^|[\s/;|&`$()=])(nc|ncat|netcat)\b", re.I, "invokes nc / ncat / netcat"),
    (r"\bsocat\b[^\n]*\b(EXEC|SYSTEM):", re.I, "socat with EXEC/SYSTEM token (spawns a process)"),
    (r"/dev/(?:tcp|udp)/", 0, "reads or writes /dev/tcp/* or /dev/udp/* (reverse-shell pattern)"),
    (r"\b(curl|wget|fetch)\b[^|\n]*\|\s*(?:bash|sh|zsh|ksh|dash|exec)\b", re.I, "pipes downloaded content directly into a shell"),
    (r"\bpython[23]?\b[^\n]*-c[^\n]*(?:socket\.socket|os\.dup2)", re.I, "python reverse-shell pattern"),
    (r"\bperl\b[^\n]*-e[^\n]*\bSocket\b", re.I, "perl reverse-shell pattern"),
    (r"base64", re.I, "references base64 (no legitimate cron use; payload-obfuscation idiom)"),
    (r"\bb64(?:decode|encode)\b", re.I, "python b64decode/b64encode (payload decoder)"),
    (r"\bfromhex\b", re.I, "fromhex (hex payload decoder)"),
    (r"\bxxd\b", re.I, "invokes xxd (hex dump / reverse-mode payload decoder)"),
    (r"\\x[0-9a-fA-F]{2}", 0, "shell hex-escape literal (\\xNN — payload obfuscation)"),
    (r"\\u[0-9a-fA-F]{4}", 0, "shell unicode-escape literal (\\uNNNN — payload obfuscation)"),
    (r"(?:^|[\s/;|&`$()=])eval\b", re.I, "invokes eval (opaque shell-string execution)"),
    (r"\bopenssl\b[^\n]*\s-d\b", re.I, "openssl with -d (decoder)"),
)]


def cron_blockers(text):
    out = []
    for i, line in enumerate(text.split("\n")):
        trimmed = line.lstrip()
        if not trimmed or trimmed[0] == "#":
            continue
        for pattern, why in CRON_RULES:
            if pattern.search(line):
                out.append(f"line {i + 1} ({why}): {line.strip()[:100]}")
                break
    return out


