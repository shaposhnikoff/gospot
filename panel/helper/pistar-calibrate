#!/usr/bin/python3 -I
"""Privileged backend of the Calibration page (admin/calibration.php).

run      Hold MMDVMHost like Pi-Star's pistar-mmdvmcal (the active units of
         CALIBRATION_HOLD_UNITS, then UNIT_MMDVMHOST), run MMDVMCal from
         PISTAR_BIN_DIR on the [Modem] UARTPort/UARTSpeed of CONF_MMDVMHOST in a
         pseudo-terminal, relay allowlisted keys from stdin to it and its output
         to stdout. When MMDVMCal quits, stdin reaches EOF (the dashboard went
         away), SIGTERM/SIGHUP/SIGINT arrives or CALIBRATION_MAX_RUNTIME passes,
         MMDVMCal is stopped and the held units are started again.
restore  Start what a session that died left stopped; a no-op otherwise.

MMDVMCal is executed directly (no shell); only the bytes in KEYS reach it.
"""
import fcntl
import json
import os
from pathlib import Path
import pty
import re
import select
import signal
import stat
import subprocess
import sys
import tempfile
import time

SETTINGS = "/etc/pistar-dashboard/pistar.conf"
# Keys the page sends (q k b J j n f F z e), the digits of the z/e arguments
# and the newline that ends them.
KEYS = frozenset(b"qkbJjnfFze0123456789\n")
UNIT = re.compile(r"[A-Za-z0-9@_.-]+\.(?:service|timer)")
LIMIT = 1 << 20


class Error(Exception):
    pass


def load_settings():
    """Read pistar.conf (KEY=value), trusted only if no one else can write it.

    Unprivileged runs (tests) may name another file in PISTAR_SETTINGS; root,
    as under sudo, always uses the installed file."""
    path = SETTINGS
    if os.geteuid() != 0:
        path = os.environ.get("PISTAR_SETTINGS", SETTINGS)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        os.close(fd)
        raise SystemExit("unsafe settings file")
    values = {}
    with os.fdopen(fd, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            key, sep, value = line.partition("=")
            if not sep or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key) or re.search(r"[\s\"'$`\\]", value) or key in values:
                raise SystemExit("invalid settings file")
            values[key] = value
    return values


def setting_path(values, key):
    value = values.get(key, "")
    if not value.startswith("/") or os.path.normpath(value) != value:
        raise SystemExit(f"{key} must be a clean absolute path")
    return Path(value)


def setting_int(values, key, low, high):
    value = values.get(key, "")
    if not re.fullmatch(r"[0-9]{1,7}", value) or not low <= int(value) <= high:
        raise SystemExit(f"{key} must be a number from {low} to {high}")
    return int(value)


class Config:
    def __init__(self, values):
        self.mmdvmhost = setting_path(values, "CONF_MMDVMHOST")
        self.mmdvmcal = setting_path(values, "PISTAR_BIN_DIR") / "MMDVMCal"
        self.state = setting_path(values, "DASHBOARD_STATE_DIR")
        self.modem_unit = values.get("UNIT_MMDVMHOST", "")
        hold = values.get("CALIBRATION_HOLD_UNITS", "")
        self.hold = [u for u in hold.split(",") if u]
        if not UNIT.fullmatch(self.modem_unit) or not all(UNIT.fullmatch(u) for u in self.hold):
            raise SystemExit("UNIT_MMDVMHOST and CALIBRATION_HOLD_UNITS must be systemd unit names")
        self.warmup = setting_int(values, "CALIBRATION_WARMUP", 0, 60)
        self.max_runtime = setting_int(values, "CALIBRATION_MAX_RUNTIME", 1, 86400)
        self.held = self.state / "calibration-held.json"


def say(text):
    """Progress lines in the words of pistar-mmdvmcal; the page reacts to them."""
    try:
        os.write(1, (text + "\r\n").encode())
    except OSError:
        pass


def systemctl(*args):
    try:
        return subprocess.run(["systemctl", *args], timeout=90, cwd="/", stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    except (OSError, subprocess.TimeoutExpired):
        return 1


def modem_port(path):
    """UARTPort (or Port) and UARTSpeed from the [Modem] section."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Error("invalid MMDVMHost configuration")
        text = f.read(LIMIT).decode("utf-8", "replace")
    section, values = "", {}
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            section = s[1:-1]
        elif section == "Modem" and "=" in s and s[0] not in "#;":
            key, _, value = s.partition("=")
            values.setdefault(key.strip(), value.strip())
    port = values.get("UARTPort") or values.get("Port", "")
    speed = values.get("UARTSpeed") or "115200"
    if not re.fullmatch(r"/dev/[A-Za-z0-9_.:+-]+(?:/[A-Za-z0-9_.:+-]+)*", port) or ".." in port:
        raise Error("no valid [Modem] UARTPort in the MMDVMHost configuration")
    if not re.fullmatch(r"[1-9][0-9]{2,6}", speed):
        raise Error("invalid [Modem] UARTSpeed in the MMDVMHost configuration")
    return port, speed


def write_held(cfg, units):
    cfg.state.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=cfg.state, prefix=".calibration-")
    with os.fdopen(fd, "w") as f:
        json.dump({"units": units, "modem": cfg.modem_unit}, f)
        f.flush()
        os.fsync(fd)
    os.replace(tmp, cfg.held)


def restore(cfg):
    """Start the held units again and restart MMDVMHost; True if anything was held."""
    try:
        fd = os.open(cfg.held, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return False
    with os.fdopen(fd) as f:
        try:
            held = json.loads(f.read(65536))
        except ValueError:
            held = {}
    units = held.get("units") if isinstance(held, dict) else None
    modem = held.get("modem") if isinstance(held, dict) else None
    if not isinstance(units, list) or not all(isinstance(u, str) and UNIT.fullmatch(u) for u in units):
        units = []
    if not isinstance(modem, str) or not UNIT.fullmatch(modem):
        modem = cfg.modem_unit
    for unit in units:
        systemctl("start", unit)
    systemctl("restart", modem)
    cfg.held.unlink(missing_ok=True)
    return True


def spawn(cfg, port, speed):
    pid, fd = pty.fork()
    if pid == 0:
        try:
            os.chdir("/")
            os.execv(str(cfg.mmdvmcal), [str(cfg.mmdvmcal), speed, port])
        finally:
            os._exit(127)
    return pid, fd


def reap(pid, timeout, fd=None):
    """Wait for pid, draining its terminal; True once it has exited."""
    end = time.monotonic() + timeout
    while True:
        if os.waitpid(pid, os.WNOHANG)[0] == pid:
            return True
        left = end - time.monotonic()
        if left <= 0:
            return False
        if fd is not None:
            try:
                if select.select([fd], [], [], min(left, 0.1))[0]:
                    os.read(fd, 4096)
            except OSError:
                fd = None
        else:
            time.sleep(min(left, 0.05))


def terminate(pid, fd):
    try:
        os.write(fd, b"q")
    except OSError:
        pass
    if reap(pid, 5, fd):
        return
    for sig, wait in ((signal.SIGTERM, 2), (signal.SIGKILL, 5)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return
        if reap(pid, wait, fd):
            return


stop_requested = False


def on_signal(signum, frame):
    global stop_requested
    stop_requested = True


def relay(pid, fd, deadline):
    """Copy keys in and output out until MMDVMCal exits (True) or the session ends."""
    stdin_open = True
    while not stop_requested and time.monotonic() < deadline:
        if os.waitpid(pid, os.WNOHANG)[0] == pid:
            return True
        watch = [fd] + ([0] if stdin_open else [])
        try:
            ready = select.select(watch, [], [], 0.2)[0]
        except InterruptedError:
            continue
        if fd in ready:
            try:
                data = os.read(fd, 4096)
            except OSError:
                data = b""
            if not data:
                # The terminal closed: MMDVMCal has exited or is exiting.
                return reap(pid, 5)
            try:
                os.write(1, data)
            except OSError:
                return False  # nobody is reading: the dashboard went away
        if 0 in ready:
            data = os.read(0, 256)
            if not data:
                return False
            keys = bytes(b for b in data if b in KEYS)
            if keys:
                os.write(fd, keys)
    return False


def run(cfg):
    cfg.state.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock = os.open(cfg.state / "calibration.lock", os.O_CREAT | os.O_NOFOLLOW | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        say("Another instance is already running")
        return 3
    # A session that died must not leave MMDVMHost stopped.
    restore(cfg)
    port, speed = modem_port(cfg.mmdvmhost)
    if not os.access(cfg.mmdvmcal, os.X_OK):
        raise Error("MMDVMCal is not installed")
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, on_signal)
    deadline = time.monotonic() + cfg.max_runtime
    say("Stopping Pi-Star Services...")
    active = [u for u in cfg.hold if systemctl("is-active", "--quiet", u) == 0]
    write_held(cfg, active)
    try:
        for unit in active + [cfg.modem_unit]:
            systemctl("stop", unit)
        say("Starting Calibration...")
        if cfg.warmup and not stop_requested:
            # pistar-mmdvmcal runs MMDVMCal twice, killing the first after 3 s.
            pid, fd = spawn(cfg, port, speed)
            try:
                reap(pid, cfg.warmup, fd)
                terminate(pid, fd)
            finally:
                os.close(fd)
        if not stop_requested:
            pid, fd = spawn(cfg, port, speed)
            try:
                if not relay(pid, fd, deadline):
                    terminate(pid, fd)
            finally:
                os.close(fd)
    finally:
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(sig, signal.SIG_IGN)
        say("Starting Pi-Star Services...")
        restore(cfg)
        say("Finnished...")
    return 0


def main():
    if os.geteuid() == 0:
        os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
    if len(sys.argv) != 2 or sys.argv[1] not in ("run", "restore"):
        print("usage: pistar-calibrate run|restore", file=sys.stderr)
        return 2
    cfg = Config(load_settings())
    os.umask(0o077)
    if sys.argv[1] == "restore":
        cfg.state.mkdir(mode=0o700, parents=True, exist_ok=True)
        lock = os.open(cfg.state / "calibration.lock", os.O_CREAT | os.O_NOFOLLOW | os.O_RDWR, 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0  # a live session restores by itself
        print("restored" if restore(cfg) else "nothing to restore")
        return 0
    return run(cfg)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Error as exc:
        say(f"Calibration failed: {exc}")
        print(f"pistar-calibrate: {exc}", file=sys.stderr)
        sys.exit(1)
