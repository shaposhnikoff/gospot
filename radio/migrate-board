#!/usr/bin/env bash
# One-time move of DEPLOY_HOST from the upstream layout (MMDVM-Host.ini,
# journald, user units in /etc/systemd/system) to the Pi-Star layout with the
# gospot-radio package. Backs everything up first and rolls back on any
# failure, including "modem did not answer" and "no DMR master login".
# Usage: radio/migrate-board path/to/gospot-radio_*.deb
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=../Pi-Star_dash_new/gospot.conf
source "$here/../Pi-Star_dash_new/gospot.conf"
deb=${1:?usage: migrate-board gospot-radio.deb}
[[ $(dpkg-deb -f "$deb" Package) == gospot-radio && $(dpkg-deb -f "$deb" Architecture) == armhf ]]
stage=/tmp/gospot-migrate
ssh -T -o BatchMode=yes "$DEPLOY_HOST" "rm -rf $stage && mkdir -m700 $stage"
scp -q -o BatchMode=yes "$deb" "$here/convert-config.py" "$DEPLOY_HOST:$stage/"
remote_vars=$(declare -p DEPLOY_HOST GOSPOT_BIN_DIR GOSPOT_HOSTS_DIR GOSPOT_LOG_DIR MARKER_MMDVMHOST \
  CONF_MMDVMHOST CONF_DMRGATEWAY UNIT_MMDVMHOST UNIT_DMRGATEWAY MIGRATE_FROM_MMDVMHOST \
  MIGRATE_FROM_DMRGATEWAY MIGRATE_FROM_DATA_DIR MIGRATION_BACKUP_DIR)
ssh -T -o BatchMode=yes "$DEPLOY_HOST" "stage=$stage deb=$(basename "$deb") bash -s" <<EOF
$remote_vars
$(cat <<'REMOTE'
set -euo pipefail
[[ $(hostname -s) == "$DEPLOY_HOST" && $(dpkg --print-architecture) == armhf ]]
test -f "$MIGRATE_FROM_MMDVMHOST" && test -f "$MIGRATE_FROM_DMRGATEWAY"
if [[ -e $CONF_MMDVMHOST || -e $CONF_DMRGATEWAY ]]; then echo "already migrated: $CONF_MMDVMHOST exists" >&2; exit 1; fi
B=$MIGRATION_BACKUP_DIR/$(date -u +%Y%m%dT%H%M%SZ)
sudo -n install -d -m 0700 "$B"
sudo -n cp -a "$MIGRATE_FROM_MMDVMHOST" "$MIGRATE_FROM_DMRGATEWAY" "$B/"
for u in "$UNIT_MMDVMHOST" "$UNIT_DMRGATEWAY"; do
  if [[ -f /etc/systemd/system/$u ]]; then sudo -n cp -a "/etc/systemd/system/$u" "$B/$u"; fi
done
for b in MMDVMHost DMRGateway; do
  if [[ -f $GOSPOT_BIN_DIR/$b ]]; then sudo -n cp -a "$GOSPOT_BIN_DIR/$b" "$B/$b.bin"; fi
done
marker_created=0
echo "Backup: $B"

rollback() {
  echo "ROLLBACK: restoring the previous radio setup" >&2
  sudo -n systemctl disable --now "$UNIT_MMDVMHOST" "$UNIT_DMRGATEWAY" 2>/dev/null || true
  sudo -n dpkg -r gospot-radio >/dev/null 2>&1 || true
  for u in "$UNIT_MMDVMHOST" "$UNIT_DMRGATEWAY"; do
    if [[ -f $B/$u ]]; then sudo -n cp -a "$B/$u" "/etc/systemd/system/$u"; fi
  done
  for b in MMDVMHost DMRGateway; do
    if [[ -f $B/$b.bin ]]; then sudo -n cp -a "$B/$b.bin" "$GOSPOT_BIN_DIR/$b"; fi
  done
  sudo -n rm -f "$CONF_MMDVMHOST" "$CONF_DMRGATEWAY"
  if (( marker_created )); then sudo -n rm -f "$MARKER_MMDVMHOST"; fi
  sudo -n systemctl daemon-reload
  sudo -n systemctl enable --now "$UNIT_DMRGATEWAY" "$UNIT_MMDVMHOST"
  systemctl is-active "$UNIT_DMRGATEWAY" "$UNIT_MMDVMHOST" >&2 || true
}
trap rollback ERR

sudo -n python3 -I "$stage/convert-config.py" "$MIGRATE_FROM_MMDVMHOST" "$MIGRATE_FROM_DMRGATEWAY" \
  "$CONF_MMDVMHOST" "$CONF_DMRGATEWAY" "$GOSPOT_LOG_DIR" "$GOSPOT_HOSTS_DIR"
if [[ ! -e $MARKER_MMDVMHOST ]]; then sudo -n touch "$MARKER_MMDVMHOST"; marker_created=1; fi

sudo -n systemctl disable --now "$UNIT_MMDVMHOST" "$UNIT_DMRGATEWAY"
sudo -n rm -f "/etc/systemd/system/$UNIT_MMDVMHOST" "/etc/systemd/system/$UNIT_DMRGATEWAY"
sudo -n systemctl daemon-reload
sudo -n dpkg -i "$stage/$deb"
for f in DMRIds.dat NXDN.csv RSSI.dat; do
  if [[ ! -e $GOSPOT_HOSTS_DIR/$f && -f $MIGRATE_FROM_DATA_DIR/$f ]]; then
    sudo -n cp -a "$MIGRATE_FROM_DATA_DIR/$f" "$GOSPOT_HOSTS_DIR/$f"
  fi
done
start=$(date -u +%s)
sudo -n systemctl enable --now "$UNIT_DMRGATEWAY" "$UNIT_MMDVMHOST"

host_log=$GOSPOT_LOG_DIR/MMDVM-$(date -u +%F).log
gw_log=$GOSPOT_LOG_DIR/DMRGateway-$(date -u +%F).log
modem=0; login=0
for _ in $(seq 1 90); do
  sleep 1
  [[ -f $host_log ]] && grep -q "MMDVM protocol version" "$host_log" && modem=1
  [[ -f $gw_log ]] && grep -q "Logged into the master successfully" "$gw_log" && login=1
  (( modem && login )) && break
done
pgrep -x MMDVMHost >/dev/null || { echo "MMDVMHost is not running" >&2; tail -20 "$host_log" >&2 || true; false; }
pgrep -x DMRGateway >/dev/null || { echo "DMRGateway is not running" >&2; tail -20 "$gw_log" >&2 || true; false; }
(( modem )) || { echo "modem did not answer" >&2; tail -20 "$host_log" >&2 || true; false; }
(( login )) || { echo "no DMR master login" >&2; tail -20 "$gw_log" >&2 || true; false; }
trap - ERR
echo "MMDVMHost: $(grep -m1 -o 'description: .*' "$host_log")"
echo "DMRGateway: $(grep 'Logged into the master successfully' "$gw_log" | tail -1)"
echo "Took $(( $(date -u +%s) - start ))s after start"
echo "PASS migrated $(hostname -s): gospot-radio $(dpkg-query -W -f='${Version}' gospot-radio), configs $CONF_MMDVMHOST $CONF_DMRGATEWAY, backup $B"
rm -rf "$stage"
REMOTE
)
EOF
