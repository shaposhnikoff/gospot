[Unit]
Description=GoSpot operator panel
After=network.target
StartLimitIntervalSec=0

[Service]
User=gospot-stage
Group=gospot-stage
ExecStart=/usr/bin/python3 -IB /opt/gospot-stage/current/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET
CapabilityBoundingSet=
UMask=0077
TasksMax=64
MemoryMax=128M

[Install]
WantedBy=multi-user.target
