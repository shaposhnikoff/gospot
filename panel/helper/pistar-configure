ZIP_MAX = 256 * 1024
UNPACKED_MAX = 4 * 1024 * 1024


def backup():
    import io, time, zipfile
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
        for name, (path, _, _) in backup_files().items():
            if name == "dhcpcd.conf":
                text, _ = read_file(path)
                # Only a static address is worth restoring (config_backup.php).
                if not text or not any("static ip_address" in l and not l.lstrip().startswith("#") for l in text.splitlines()):
                    continue
            data, _ = read_file(path)
            if data is not None:
                z.writestr(zipfile.ZipInfo(name, time.gmtime()[:6]), data)
    return buf.getvalue()


def restore(blob, run=None, is_loaded=None):
    import io, zipfile
    run = run or systemctl
    is_loaded = is_loaded or loaded
    out = []
    if not (0 < len(blob) <= ZIP_MAX):
        return {"ok": False, "output": [f"Uploaded file is empty or too large (limit {ZIP_MAX // 1024} KB)."]}
    try:
        z = zipfile.ZipFile(io.BytesIO(blob))
        infos = z.infolist()
    except zipfile.BadZipFile:
        return {"ok": False, "output": ["Uploaded file is not a valid .zip archive."]}
    allowed = backup_files()
    admit = {}
    total = 0
    for info in infos:
        name = info.filename
        if not name:
            continue
        if "/" in name or "\\" in name or "\0" in name or name.startswith("."):
            return {"ok": False, "output": [f"Refusing ZIP — entry '{name[:64]}' has an unsafe name."]}
        total += info.file_size
        if total > UNPACKED_MAX:
            return {"ok": False, "output": ["Refusing ZIP — unpacked size is too large."]}
        if name in allowed:
            admit[name] = info
    timezone = None
    if "config.php" in {i.filename for i in infos}:
        m = re.search(rb"date_default_timezone_set\(\s*['\"]([^'\"]+)['\"]\s*\)", z.read("config.php")[:65536])
        if m and Path("/usr/share/zoneinfo", m.group(1).decode(errors="replace")).is_file():
            timezone = m.group(1).decode()
    if not admit:
        return {"ok": False, "output": ["ZIP contained no recognised Pi-Star config files."]}
    contents = {}
    for name, info in admit.items():
        data = z.read(info)
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            return {"ok": False, "output": [f"Refusing ZIP — {name} is not a text file."]}
        require("\0" not in text, "binary content")
        contents[name] = text
    out.append(f"Your .zip file was uploaded and unpacked ({len(admit)} files).")
    import pwd
    # Snapshot everything a restore may touch, including both markers.
    touched = set(admit) | {"dstar-radio.mmdvmhost", "dstar-radio.dstarrepeater"}
    before = {}
    for name in touched:
        path = allowed[name][0]
        text, st = read_file(path)
        before[name] = (text, st)
    written = []
    try:
        out.append("Writing new Config")
        if any(n.startswith("dstar-radio.") for n in admit):
            for n in ("dstar-radio.mmdvmhost", "dstar-radio.dstarrepeater"):
                allowed[n][0].unlink(missing_ok=True)
                written.append(n)
        for name, text in contents.items():
            path, mode, owner = allowed[name]
            # root under sudo; the running user in unprivileged tests
            uid, gid = (0, 0) if os.geteuid() == 0 else (os.geteuid(), os.getegid())
            if owner and os.geteuid() == 0:
                pw = pwd.getpwnam(owner)
                uid, gid = pw.pw_uid, pw.pw_gid

            class Target:
                st_uid, st_gid, st_mode = uid, gid, mode
            replace(path, text, Target)
            written.append(name)
        out.append(f"Installed {len(contents)} file(s).")
        if timezone:
            subprocess.run(["/usr/bin/timedatectl", "set-timezone", timezone], check=True, timeout=30,
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            out.append(f"Timezone set to {timezone}.")
        out.append("Starting Services.")
        for unit in RESTORE_UNITS:
            if is_loaded(unit):
                run("restart", unit)
    except Exception as exc:
        # The reason goes to the caller's log; it never includes values.
        print(f"pistar-configure: apply failed: {type(exc).__name__}", file=sys.stderr)
        for name in reversed(written):
            text, st = before[name]
            path = allowed[name][0]
            if text is None:
                path.unlink(missing_ok=True)
            else:
                replace(path, text, st)
        for unit in RESTORE_UNITS:
            try:
                if is_loaded(unit):
                    run("restart", unit)
            except Exception:
                pass
        return {"ok": False, "output": out + ["Restore failed; previous configuration restored."]}
    out.append("Configuration restored.")
    return {"ok": True, "output": out}


