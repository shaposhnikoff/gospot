#!/bin/bash
# Privileged entry point for the Update page. Replaces Pi-Star's pistar-update,
# which pulls the PHP dashboard from git: refresh the Pi-Star data sets and
# upgrade the OS packages, writing progress to PISTAR_UPDATE_LOG.
set -euo pipefail
. /etc/pistar-dashboard/pistar.conf
log=$PISTAR_UPDATE_LOG
unit=pistar-native-update.service
case "${1:-}" in
  start)
    if /usr/bin/systemctl is-active --quiet "$unit"; then echo "already running" >&2; exit 3; fi
    install -d -o root -g "$RADIO_USER" -m 0775 "$(dirname "$log")"
    : >"$log"
    chmod 0644 "$log"
    /usr/bin/systemd-run --quiet --collect --unit="$unit" "$(readlink -f "$0")" run
    echo started
    ;;
  run)
    exec >>"$log" 2>&1
    export DEBIAN_FRONTEND=noninteractive
    echo "Pi-Star update started $(date -u '+%F %T') UTC"
    echo "== Updating host files and ID databases"
    if "$PISTAR_SBIN_DIR/HostFilesUpdate.sh"; then echo "Host files updated"; else echo "HostFilesUpdate.sh failed"; fi
    echo "== Updating package lists"
    apt-get update
    echo "== Upgrading packages"
    apt-get -y -o Dpkg::Options::=--force-confold upgrade
    echo "Finished $(date -u '+%F %T') UTC"
    echo "Update complete"
    ;;
  *) echo "usage: pistar-native-update start" >&2; exit 2 ;;
esac
