def keys_write(request):
    """apikey_install_ini(): rewrite the whole file, empty values as "none"."""
    require(type(request) is dict and set(request) == {"target", "values"} and request["target"] in KEYS, "invalid request")
    values = request["values"]
    require(type(values) is dict and values, "invalid values")
    lines = []
    for section, keys in values.items():
        require(type(section) is str and NAME.fullmatch(section) and type(keys) is dict, "invalid section")
        lines.append(f"[{section}]")
        for key, value in keys.items():
            require(type(key) is str and NAME.fullmatch(key) and "=" not in key, "invalid key")
            require(type(value) is str and VALUE.fullmatch(value), "invalid value")
            lines.append(f"{key}={value if value != '' else 'none'}")
        lines.append("")
    import pwd
    owner = pwd.getpwnam(KEY_OWNER)

    class Private:
        st_uid, st_gid, st_mode = owner.pw_uid, owner.pw_gid, 0o600
    replace(KEYS[request["target"]][0], "\n".join(lines) + "\n", Private)
    return {"ok": True}


