#!/bin/sh
set -eu
[ "$1" = configure ] || exit 0
. @RADIO_SHARE_DIR@/paths
if ! getent group "$RADIO_USER" >/dev/null; then groupadd --system "$RADIO_USER"; fi
if ! getent passwd "$RADIO_USER" >/dev/null; then
    useradd --system --gid "$RADIO_USER" --groups dialout,tty --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$RADIO_USER"
fi
install -d -o root -g "$RADIO_USER" -m 0775 "$GOSPOT_LOG_DIR"
install -d -m 0755 "$GOSPOT_HOSTS_DIR"
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
# A board upgraded from the replaced radio package: move its Pi-Star layout (logs, release
# file, CSS, remote and keeper files, unit enablement) to the GoSpot names.
# Does nothing on a fresh system or a second run.
python3 -I "$RADIO_SHARE_DIR/gospot-radio-migrate" "$RADIO_SHARE_DIR/paths" "$RADIO_SHARE_DIR/rename.table"
if [ ! -e "$GOSPOT_RELEASE_FILE" ]; then
    printf '[GoSpot]\nVersion = 4.3-native\nHardware = RPi\n' >"$GOSPOT_RELEASE_FILE"
fi
# Missing radio configurations start from the Pi-Star defaults rewritten for
# the GoSpot layout, as on a Pi-Star image; existing files are never touched.
"$RADIO_SHARE_DIR/seed-configs" "$RADIO_SHARE_DIR/config-seed" "$RADIO_SHARE_DIR/config_clean.zip" "$RADIO_SHARE_DIR/rename.table"
ldconfig
if [ -d /run/systemd/system ]; then
    # Data sets only; radio services are enabled by the operator or radio/migrate-board.
    systemctl enable --now gospot-hostfiles.timer >/dev/null
fi
