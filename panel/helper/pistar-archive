#!/usr/bin/python3 -I
"""Private, device-bound backups of the two local Pi-Star service INIs.

Install root:root 0755 in /usr/local/libexec. Permit only the three literal
verbs backup, preview, apply in sudoers. ZIPs are authenticated, NOT encrypted.
Keep sudo input/output logging disabled for these three commands: their pipes
carry private data. Live files must be regular, singly linked, UTF-8 INIs
(256 KiB each maximum), with no special bits or group/other write permission.
The signing key is generated on first export, in the same root-only 0700 state
directory and under the same lock as pistar-config. Never export or clone the
key with an image. Losing it invalidates that device's archives. Only the local
service files are ever signed; the account owning each file must stay the same
on restore. Owners of those live configs are trusted for their own service.

backup: no input, returns a PRIVATE ZIP. preview: ZIP on stdin, returns JSON.
apply: preview receipt (64 hex digits + LF) then identical ZIP on stdin.
The receipt binds both the archive and the current configuration snapshot.
On a successful change, pistar-config rollback can use previous.json. After
interruption or incomplete recovery, preserve pending.json, reconcile files
and services manually, then remove the pending marker (see helper README).
"""
import errno
import fcntl
import hashlib
import hmac
import io
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
import zipfile


SETTINGS = "/etc/pistar-dashboard/pistar.conf"


def load_settings():
    """Read pistar.conf (KEY=value), trusted only if no one else can write it.

    Unprivileged runs (tests) may name another file in PISTAR_SETTINGS; root,
    as under sudo, always uses the installed file."""
    path = SETTINGS
    if os.geteuid() != 0:
        path = os.environ.get("PISTAR_SETTINGS", SETTINGS)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        os.close(fd)
        raise SystemExit("unsafe settings file")
    values = {}
    with os.fdopen(fd, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            key, sep, value = line.partition("=")
            if not sep or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key) or re.search(r"[\s\"'$`\\]", value) or key in values:
                raise SystemExit("invalid settings file")
            values[key] = value
    return values


def setting_path(values, key):
    value = values.get(key, "")
    if not value.startswith("/") or os.path.normpath(value) != value:
        raise SystemExit(f"{key} must be a clean absolute path")
    return Path(value)


def setting_unit(values, key):
    value = values.get(key, "")
    if not re.fullmatch(r"[A-Za-z0-9@_.-]+\.service", value):
        raise SystemExit(f"{key} must be a systemd service name")
    return value


_SETTINGS = load_settings()
PATHS = (setting_path(_SETTINGS, "CONF_MMDVMHOST"), setting_path(_SETTINGS, "CONF_DMRGATEWAY"))
# Archive members carry the file names of the configured paths.
NAMES = tuple(p.name for p in PATHS)
STATE = setting_path(_SETTINGS, "DASHBOARD_STATE_DIR")
UNITS = (setting_unit(_SETTINGS, "UNIT_MMDVMHOST"), setting_unit(_SETTINGS, "UNIT_DMRGATEWAY"))
FILE_MAX = 256 * 1024
ZIP_MAX = 2 * FILE_MAX + 1024
COMMENT = b"Pi-Star PRIVATE archive v1 | "
REQUIRED = (
    {"General": ("Callsign", "Id"), "Modem": ("UARTPort", "RXFrequency", "TXFrequency")},
    {"General": ("Id",), "DMR Network 1": ("Address", "Port", "Password")},
)


class Invalid(Exception):
    """Invalid upload or stale preview."""


def check(ok):
    if not ok:
        raise Invalid()


def sanity(data, index):
    check(0 < len(data) <= FILE_MAX)
    sections = set()
    required = {(s, k) for s, keys in REQUIRED[index].items() for k in keys}
    found = set()
    section = None
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Invalid() from None
    check(not re.search(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]|\r(?!\n)", text))
    for line in text.split("\n"):
        check(len(line) <= 4096)
        line = line.strip(" \t\r")
        if not line or line[0] in "#;":
            continue
        if line.startswith("["):
            check(re.fullmatch(r"\[[A-Za-z0-9 _.-]{1,80}\]", line))
            section = line[1:-1]
            check(section not in sections)
            sections.add(section)
        else:
            key, eq, value = line.partition("=")
            key = key.strip()
            check(section and eq and re.fullmatch(r"[A-Za-z0-9_.-]{1,100}", key))
            pair = (section, key)
            if pair in required:
                check(pair not in found)
                check(key == "Password" or value.partition("#")[0].strip())
                found.add(pair)
    check(found == required)


def read_file(path, limit, private=False):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(fd)
        mode = stat.S_IMODE(st.st_mode)
        if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size > limit
                or mode & 0o7022 or (private and (mode != 0o600 or st.st_uid != os.geteuid()))):
            raise OSError("unsafe local file")
        data = f.read(limit + 1)
        if len(data) > limit:
            raise OSError("oversized local file")
        return data, st


def sync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def replace(path, data, owner, group, mode):
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fchown(fd, owner, group)
            os.fchmod(fd, mode)
            os.fsync(fd)
        os.replace(tmp, path)
        sync_dir(path.parent)
    finally:
        Path(tmp).unlink(missing_ok=True)


def key_for(creating):
    path = STATE / "archive.key"
    try:
        key, _ = read_file(path, 32, private=True)
    except FileNotFoundError:
        if not creating:
            raise Invalid() from None
        key = os.urandom(32)
        replace(path, key, os.geteuid(), os.getegid(), 0o600)
    if len(key) != 32:
        raise OSError("invalid local key")
    return key


def sign(key, stats, payload):
    # Do not promote data signed for an unprivileged owner to a different owner.
    owners = b"".join(st.st_uid.to_bytes(4, "big") for st in stats)
    return hmac.digest(key, b"pistar:zip:v1\0" + owners + payload, "sha256").hex().encode()


def pack(key, originals, stats):
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", allowZip64=False) as z:
        for name, data in zip(NAMES, originals):
            entry = zipfile.ZipInfo(name)
            entry.create_system = 3
            entry.external_attr = (stat.S_IFREG | 0o600) << 16
            z.writestr(entry, data)
        z.comment = COMMENT + b"0" * 64
    prefix = buf.getvalue()[:-64]
    return prefix + sign(key, stats, prefix)


def unpack(key, blob, stats):
    check(64 < len(blob) <= ZIP_MAX)
    # Authenticate the entire envelope before even parsing the ZIP directory.
    check(hmac.compare_digest(blob[-64:], sign(key, stats, blob[:-64])))
    with zipfile.ZipFile(io.BytesIO(blob)) as z:
        infos = z.infolist()
        check(z.comment == COMMENT + blob[-64:] and len(infos) == len(NAMES))
        files = []
        for i, (info, name) in enumerate(zip(infos, NAMES)):
            check(info.orig_filename == name and info.filename == name and
                  info.compress_type == zipfile.ZIP_STORED and info.flag_bits == 0 and
                  info.compress_size == info.file_size <= FILE_MAX and
                  info.external_attr == (stat.S_IFREG | 0o600) << 16 and
                  not info.extra and not info.comment)
            with z.open(info) as f:
                data = f.read(FILE_MAX + 1)
            check(len(data) == info.file_size)
            sanity(data, i)
            files.append(data)
    return files


def restart(unit):
    subprocess.run(["/usr/bin/systemctl", "restart", unit], timeout=20, check=True,
                   cwd="/", env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def transaction(action, raw, run):
    pending = STATE / "pending.json"
    if os.path.lexists(pending):
        raise OSError("pending transaction")
    original, stats = zip(*(read_file(path, FILE_MAX) for path in PATHS))
    if action == "backup":
        for i, data in enumerate(original):
            sanity(data, i)
        return pack(key_for(True), original, stats)
    key = key_for(False)
    receipt = b""
    if action == "apply":
        receipt, sep, raw = raw.partition(b"\n")
        check(sep and re.fullmatch(b"[a-f0-9]{64}", receipt))
    target = unpack(key, raw, stats)
    digest = hashlib.sha256(raw).digest()
    for data, st in zip(original, stats):
        digest += hashlib.sha256(data).digest() + f"{st.st_uid}:{st.st_gid}:{st.st_mode};".encode()
    expected = hmac.digest(key, b"pistar:preview:v1\0" + digest, "sha256").hex()
    changed = [i for i in range(len(NAMES)) if original[i] != target[i]]
    if action == "preview":
        return json.dumps({"receipt": expected, "changed": [NAMES[i] for i in changed]}).encode()
    check(hmac.compare_digest(receipt, expected.encode()))
    if changed:
        # Format shared with pistar-config; blocks its mutations during recovery.
        snapshot = json.dumps([d.decode() for d in original]).encode()
        replace(pending, snapshot, os.geteuid(), os.getegid(), 0o600)
        attempted_files, attempted_units = [], []

        def install(i, contents):
            st = stats[i]
            replace(PATHS[i], contents[i], st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode))

        try:
            for i in changed:
                attempted_files.append(i)
                install(i, target)
            for i in reversed(changed):  # gateway before host
                attempted_units.append(i)
                run(UNITS[i])
            os.replace(pending, STATE / "previous.json")
        except Exception:
            recovered = True
            for i in reversed(attempted_files):
                try:
                    install(i, original)
                except Exception:
                    recovered = False
            for i in attempted_units:
                try:
                    run(UNITS[i])
                except Exception:
                    recovered = False
            if recovered:
                pending.unlink()
                sync_dir(STATE)
            raise OSError("restore failed") from None
        sync_dir(STATE)
    return b'{"ok":true}'


def execute(action, raw=b"", run=restart):
    check(action in ("backup", "preview", "apply"))
    check(len(raw) <= ZIP_MAX + (65 if action == "apply" else 0))
    STATE.mkdir(mode=0o700, exist_ok=True)
    st = STATE.lstat()
    if not stat.S_ISDIR(st.st_mode) or stat.S_IMODE(st.st_mode) != 0o700 or st.st_uid != os.geteuid():
        raise OSError("unsafe state directory")
    with os.fdopen(os.open(STATE / "lock", os.O_RDWR | os.O_NOFOLLOW | os.O_CREAT, 0o600), "rb+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return transaction(action, raw, run)


if __name__ == "__main__":
    try:
        check(len(sys.argv) == 2)
        verb = sys.argv[1]
        raw = sys.stdin.buffer.read(ZIP_MAX + 66) if verb in ("preview", "apply") else b""
        sys.stdout.buffer.write(execute(verb, raw))
    except (Invalid, zipfile.BadZipFile):
        sys.exit(2)
    except OSError as exc:
        sys.exit(3 if exc.errno in (errno.EWOULDBLOCK, errno.EAGAIN) else 1)
    except Exception:
        # Input, filesystem diagnostics and systemctl output may contain secrets.
        sys.exit(1)
