#!/bin/bash
# Privileged entry point for Expert > FW: list the firmware types
# gospot-modemupgrade (Pi-Star's pistar-modemupgrade) knows, or flash one of them in a detached job that
# writes MODEM_FLASH_LOG.
set -euo pipefail
. /etc/gospot/gospot.conf
tool=$GOSPOT_SBIN_DIR/gospot-modemupgrade
unit=gospot-modem-flash.service
case "${1:-}" in
  list) exec "$tool" list ;;
  flash)
    want=${2:-}
    "$tool" list | grep -qxF -- "$want" || { echo "unknown modem type" >&2; exit 2; }
    if /usr/bin/systemctl is-active --quiet "$unit"; then echo "already running" >&2; exit 3; fi
    : >"$MODEM_FLASH_LOG"
    chmod 0644 "$MODEM_FLASH_LOG"
    /usr/bin/systemd-run --quiet --collect --unit="$unit" "$tool" "$want"
    echo started
    ;;
  *) echo "usage: gospot-modem list|flash TYPE" >&2; exit 2 ;;
esac
