#!/bin/sh
# gospot-wizard-secrets [--password-stdin]: create the missing credentials of
# the HTTPS management service in WIZARD_CONFIG_DIR: the admin password
# (64 random hex digits, or the first line of standard input with
# --password-stdin), the TLS key and its self-signed certificate. Existing
# files are kept. Used by the package postinst and by the OS image first boot,
# so both produce the same files with the same modes.
set -eu
from_stdin=0
case ${1:-} in
    --password-stdin) from_stdin=1 ;;
    '') ;;
    *) echo "usage: $0 [--password-stdin]" >&2; exit 2 ;;
esac
# Paths come from the package conffile (Pi-Star_dash_new/gospot.conf). Only
# unprivileged runs (tests) may name another file.
conf=/etc/gospot/gospot.conf
if [ "$(id -u)" -ne 0 ]; then conf=${GOSPOT_SETTINGS:-$conf}; fi
# shellcheck source=/dev/null
. "$conf"
cfg=$WIZARD_CONFIG_DIR
install -d -m755 "$cfg"
umask 077
if [ ! -e "$cfg/admin-password" ]; then
    tmp=$(mktemp "$cfg/.admin-password.XXXXXX")
    if [ "$from_stdin" = 1 ]; then
        IFS= read -r password || true
        if [ -z "$password" ]; then rm -f "$tmp"; echo "empty admin password" >&2; exit 1; fi
        printf '%s\n' "$password" >"$tmp"
    else
        openssl rand -hex 32 >"$tmp"
    fi
    mv "$tmp" "$cfg/admin-password"
fi
if [ ! -e "$cfg/tls-key.pem" ] && [ ! -e "$cfg/tls-cert.pem" ]; then
    host=$(hostname -s)
    san="DNS:$host,DNS:$host.local"
    for ip in $(hostname -I 2>/dev/null); do san="$san,IP:$ip"; done
    openssl req -x509 -nodes -newkey rsa:3072 -days 825 -subj "/CN=$host" \
        -addext "subjectAltName=$san" \
        -keyout "$cfg/tls-key.pem" -out "$cfg/tls-cert.pem" 2>/dev/null
    chmod 644 "$cfg/tls-cert.pem"
fi
test -s "$cfg/admin-password"
test -s "$cfg/tls-key.pem"
openssl x509 -in "$cfg/tls-cert.pem" -noout -checkend 0 >/dev/null
