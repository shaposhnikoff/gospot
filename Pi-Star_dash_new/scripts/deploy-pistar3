#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
action=${1:-deploy}
ui=dist
server=staging/server.py
tar_opts=()
case "$action" in
    --release)
        [[ $# == 2 && $2 =~ ^release-[a-zA-Z0-9]+$ ]] || exit 2
        ui="build/$2/docroot/operator"
        tar_opts+=(--transform "s|^$ui\\(/\\|$\\)|dist\\1|")
        if [[ -f $root/build/$2/staging/server.py ]]; then
            server="build/$2/staging/server.py"
            tar_opts+=(--transform "s|^$server$|staging/server.py|")
        fi
        action=deploy ;;
    deploy|--server-only|--rollback|--remove) [[ $# -le 1 ]] ;;
    *) echo "usage: $0 [--release release-ID|--server-only|--rollback|--remove]" >&2; exit 2 ;;
esac

ssh_opts=(-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=8)
key=${PISTAR3_SSH_KEY:-"$root/../id_ed25519_192.168.210.194"}
if [[ -f $key ]]; then ssh_opts+=(-o IdentitiesOnly=yes -i "$key"); fi
remote() { ssh "${ssh_opts[@]}" max@192.168.210.194 "$@"; }

files=(staging/install.sh "$server" staging/gospot-stage.service staging/pending.html)
if [[ $action == deploy ]]; then
    [[ -s $root/$ui/index.html ]] || { echo "Missing $ui/index.html" >&2; exit 1; }
    if [[ -n $(find "$root/$ui" ! -type d ! -type f -print -quit) ]]; then
        echo "$ui must contain only regular files and directories" >&2; exit 1
    fi
    files+=("$ui")
fi
tmp=$(remote 'test "$(hostname -s)" = pistar3 && sudo -n true && mktemp -d /tmp/gospot-stage.XXXXXXXX')
[[ $tmp =~ ^/tmp/gospot-stage\.[a-zA-Z0-9]{8}$ ]]
trap 'remote "rm -rf -- $tmp"' EXIT
tar -C "$root" "${tar_opts[@]}" -cf - "${files[@]}" | remote "tar -xf - -C $tmp"
remote "sudo -n bash $tmp/staging/install.sh $action"
