# Dashboard sources only. This working directory also contains private board
# keys, installation logs and independent OS-build work.
/*
!/.gitignore
!/.gitmodules
!/AGENTS.md
!/.github/
!/Pi-Star_dash_new/
!/Pi-Star_DV_Dash
!/panel/
!/radio/
!/image/
# The OS image pipeline (build.sh, verify-artifact.sh, stage-local/) is tracked;
# builds live under IMAGE_BUILD_PARENT (/var/tmp), outside the repository.
# Only the package inputs in stage-mmdvm/00-install/files/ remain of the old pipeline.
/image/stage-mmdvm/*
!/image/stage-mmdvm/00-install/
/image/stage-mmdvm/00-install/*
!/image/stage-mmdvm/00-install/files/
**/__pycache__/
**/*.pyc
**/node_modules/
**/dist/
**/build/
**/*.deb
**/*.pem
**/id_ed25519*
/Pi-Star_dash_new/qa/evidence/
/Pi-Star_dash_new/docs/TEST-REPORT.md

# go test -cpuprofile leaves the test binary
/panel/*.test
